# Required
DISCORD_TOKEN=your_discord_bot_token_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLIENT_ID=your_bot_application_id_here

# Optional: restrict bot to a specific channel (e.g. notes, meeting-notes)
# Leave blank to allow the bot in all channels
NOTES_CHANNEL=

# Optional: for instant slash command registration during dev (your server ID)
# Leave blank to register globally (takes up to 1 hour)
GUILD_ID=

# Optional overrides
PREFIX=!
CLAUDE_MODEL=claude-sonnet-4-6
# OUTPUT_FORMAT: auto | embed | file
OUTPUT_FORMAT=auto
